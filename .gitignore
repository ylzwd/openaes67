# private keys and certificates: test signing material must never be published,
# wherever it is generated (driver/out, a temp dir, or a future script).
*.pfx
*.cer
*.pvk
*.snk
*.key
*.pem

# NuGet packaging intermediates
packaging/nuget/bin/
packaging/nuget/obj/
packaging/nuget/out/