; Minimal INF for the M6 toolchain probe driver.
;
; It is deliberately tiny: one root-enumerated device, one service, no hardware
; IDs. Its purpose is to let stampinf and Inf2Cat validate the packaging path.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=openaes67_probe.cat
DriverVer=
PnpLockdown=1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
openaes67_probe.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ManufacturerName%=Probe,NTamd64

[Probe.NTamd64]
%DeviceName%=Probe_Install, ROOT\OpenAes67Probe

[Probe_Install.NT]
CopyFiles=Probe_CopyFiles

[Probe_Install.NT.Services]
AddService=openaes67_probe,%SPSVCINST_ASSOCSERVICE%,Probe_ServiceInstall

[Probe_CopyFiles]
openaes67_probe.sys

[Probe_ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\openaes67_probe.sys

[Strings]
ProviderName="OpenAES67 contributors"
ManufacturerName="OpenAES67"
DeviceName="OpenAES67 toolchain probe"
ServiceName="OpenAES67 probe driver"
DiskName="OpenAES67 driver package"
